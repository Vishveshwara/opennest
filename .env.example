COMPOSE_PROJECT_NAME=opennest
OPENNEST_ENVIRONMENT=DEVELOPMENT
OPENNEST_DATA_MODE=PRIMARY
OPENNEST_DEVELOPMENT_AUTH=false
OPENNEST_PERSONA_SWITCHING=false
OPENNEST_DEMO_RESET=false
OPENNEST_DEMO_TELEMETRY=false
DB_HOST=127.0.0.1
DB_NAME=opennest
DB_USER=opennest
DB_PASSWORD=
DB_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
SANDBOX_DB_HOST=127.0.0.1
SANDBOX_DB_NAME=opennest_sandbox
SANDBOX_DB_USER=opennest_sandbox
SANDBOX_DB_PASSWORD=
SANDBOX_DB_PORT=5433
SANDBOX_REDIS_HOST=127.0.0.1
SANDBOX_REDIS_PORT=6380
SANDBOX_REDIS_USER=
SANDBOX_REDIS_PASSWORD=

# Enable Telegram only after configuring bot credentials and exact origins.
OPENNEST_BACKEND_ORIGIN=http://localhost:8080
OPENNEST_FRONTEND_ORIGIN=http://localhost:3000
SANDBOX_BACKEND_ORIGIN=http://localhost:8081
SANDBOX_FRONTEND_ORIGIN=http://localhost:3001
# Deferred WhatsApp integration; configuration alone must not enable it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
OPENNEST_TELEGRAM_AUTH_ENABLED=false
OPENNEST_TELEGRAM_POLLING_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OTP_HMAC_KEY=
SANDBOX_TELEGRAM_BOT_USERNAME=
SANDBOX_TELEGRAM_BOT_TOKEN=
SANDBOX_TELEGRAM_WEBHOOK_SECRET=
SANDBOX_TELEGRAM_OTP_HMAC_KEY=
OPENNEST_STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_KEY=
R2_STAGING_BUCKET=
R2_FINAL_BUCKET=
SANDBOX_R2_ACCOUNT_ID=
SANDBOX_R2_ACCESS_KEY_ID=
SANDBOX_R2_SECRET_KEY=
