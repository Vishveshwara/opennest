{
  "info": {
    "name": "OpenNest Telegram login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Telegram is the only authentication provider. Start OpenNest with local Telegram auth/polling enabled. Keep the localhost cookie jar enabled. No Google login or copied browser cookie is required. Fetch CSRF, set your own +91 phoneNumber privately, create challenge, open botUrl, Start and share your own Telegram contact, then enter the delivered code as local otp and complete in this cookie session. Refresh CSRF after login. Status polling never authenticates. Do not export real contacts, codes, cookies or secrets."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "phoneNumber",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "fullName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Get anonymous CSRF token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CSRF token received', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('csrfToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Start Telegram login challenge",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/telegram/challenges",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Challenge created', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('challengeId', pm.response.json().challengeId);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Check status, at least two seconds apart",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/telegram/challenges/{{challengeId}}"
      }
    },
    {
      "name": "4. Complete with bot OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/telegram/challenges/{{challengeId}}/complete",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{otp}}\",\n  \"fullName\": \"{{fullName}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "New-user correct OTP with an empty name returns NAME_REQUIRED while anonymous. Set fullName privately and repeat within the original expiry. Returning linked users receive AUTHENTICATED directly and retain their name."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Verified signup step or authenticated account', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.be.oneOf(['NAME_REQUIRED', 'AUTHENTICATED']); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Refresh CSRF after session rotation",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CSRF token received', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('csrfToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Read private verified profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Own verified profile', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().phoneVerified).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Log out with fresh CSRF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged out', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Confirm logged-out profile is denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authentication required', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional. Resend code on the current challenge",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/telegram/challenges/{{challengeId}}/resend",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Run only for a missed code after cooldown, or pending CODE_READY delivery. Three fresh resends per challenge. Copy the latest bot code to the private otp variable. Original expiry and bad attempts are preserved."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code sent for the same challenge', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('CODE_SENT'); });"
            ]
          }
        }
      ]
    }
  ]
}
